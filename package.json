{
  "$schema": "https://www.schemastore.org/package",
  "name": "effect-numeric",
  "version": "0.0.0",
  "description": "Effect-native numeric types: fixed-width integers with checked, wrapping, saturating and overflowing arithmetic, clamped ranges, rationals, complex numbers and num-traits style type classes.",
  "keywords": [
    "checked",
    "complex",
    "effect",
    "effect-ts",
    "integer",
    "num",
    "numeric",
    "overflow",
    "rational",
    "saturating",
    "wrapping"
  ],
  "homepage": "https://github.com/thomasfosterau/effect-numeric#readme",
  "bugs": {
    "url": "https://github.com/thomasfosterau/effect-numeric/issues"
  },
  "license": "MIT",
  "author": "Thomas Foster <me@thomasfoster.au>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thomasfosterau/effect-numeric.git"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    },
    "./internal/*": null,
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "changeset": "changeset",
    "version": "changeset version && vp fmt && pnpm install --lockfile-only",
    "release": "vp run build && pnpm -r publish --access public --no-git-checks --ignore-scripts && changeset tag",
    "fallow": "fallow --summary",
    "fallow:audit": "fallow audit",
    "prepare": "vp config && effect-tsgo patch --typescript --oxlint"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "catalog:",
    "@changesets/changelog-github": "catalog:",
    "@changesets/cli": "catalog:",
    "@effect/language-service": "catalog:",
    "@effect/tsgo": "catalog:",
    "@mpsuesser/oxlint-plugin-effect": "catalog:",
    "@types/node": "catalog:",
    "@typescript/native": "catalog:",
    "@vitest/coverage-istanbul": "catalog:",
    "effect": "catalog:",
    "effect-solutions": "catalog:",
    "fallow": "catalog:",
    "fast-check": "catalog:",
    "publint": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "effect": "catalog:peers"
  },
  "engines": {
    "node": ">=22",
    "pnpm": ">=11"
  },
  "packageManager": "pnpm@11.28.6"
}

{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "entry": ["src/*.ts", "test/**/*.test.ts", "vite.config.ts"],
  "ignorePatterns": ["**/dist/**", "**/coverage/**"],
  "ignoreDependencies": [
    "@types/node",
    "@effect/tsgo",
    "@effect/language-service",
    "@typescript/native",
    "typescript",
    "tsx",
    "vite",
    "vitest",
    "vite-plus",
    "@changesets/cli",
    "@changesets/changelog-github",
    "@vitest/coverage-istanbul",
    "@arethetypeswrong/cli",
    "publint",
    "fallow"
  ],
  // `pipe` is the Effect `Pipeable` protocol. On `Value` (src/internal/value.ts),
  // the base class of `Ratio` and `Complex`, consumers call it through the public
  // interfaces (test/Pipeable.test.ts), which fallow does not trace.
  "usedClassMembers": ["pipe"],
  "rules": {
    "unused-files": "error",
    "unused-exports": "error",
    "unused-types": "error",
    "unused-dependencies": "error",
    "unused-dev-dependencies": "warn",
    "unused-enum-members": "error",
    "unused-class-members": "warn",
    "unresolved-imports": "error",
    "unlisted-dependencies": "error",
    "duplicate-exports": "error",
    "circular-dependencies": "error",
    "boundary-violation": "error",
    "stale-suppressions": "warn"
  },
  // The published code never imports test code; tests import `src` directly.
  "boundaries": {
    "zones": [
      { "name": "src", "patterns": ["src/**"] },
      { "name": "test", "patterns": ["test/**"] }
    ],
    "rules": [
      { "from": "src", "allow": [] },
      { "from": "test", "allow": ["src"] }
    ]
  },
  "health": {
    "maxCyclomatic": 20,
    "maxCognitive": 15,
    "maxCrap": 30,
    "coverage": "coverage/coverage-final.json"
  }
}

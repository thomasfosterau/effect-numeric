{
  "$schema": "./node_modules/@effect/tsgo/schema.json",
  // The declaration build `vp pack` (tsdown) runs: `src` only, so the emitted
  // `.d.ts` never references test-only types.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": [],
    "stripInternal": true
  },
  "include": ["src"]
}
